{
  "name": "ai-tennis-coach-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ball-tracks": "node scripts/validate-ball-tracks.mjs",
    "test:browser": "node scripts/browser-pose-validation.mjs",
    "test:browser:ball": "node scripts/browser-ball-validation.mjs",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run test:ball-tracks && npm run build && npm run smoke",
    "source:hash": "node scripts/source-revision.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide-react": "^1.41.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  }
}
